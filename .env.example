# Referência de variáveis — em produção defina direto no painel da hospedagem (o app lê do ambiente).

# Porta do servidor (padrão 3000)
PORT=3000

# ---------------------------------------------------------------------------
# SENHAS (defina ANTES do primeiro deploy; só valem na criação do banco)
# ---------------------------------------------------------------------------
# Senha do painel MASTER (/master) — você, dono do sistema
MASTER_PASSWORD=troque-esta-senha

# Senha inicial da loja principal (Prática Sabores). As demais lojas você cria
# pelo painel master, definindo a senha de cada cliente na hora.
ADMIN_PASSWORD=pratica123

# Dados da loja principal criada no primeiro boot
# DEFAULT_STORE_NAME=Prática Sabores
# DEFAULT_STORE_SLUG=pratica-sabores
# DEFAULT_STORE_WHATSAPP=5555997023507

# ---------------------------------------------------------------------------
# ARMAZENAMENTO (use disco persistente em produção)
# ---------------------------------------------------------------------------
# DATA_DIR=/var/data
# UPLOAD_DIR=/var/data/uploads
# NODE_ENV=production

# Keep-alive interno (só ajuda no plano free; não substitui monitor externo)
# KEEP_ALIVE_URL=https://seu-site.onrender.com
# KEEP_ALIVE_MINUTES=10

# --- Contrato de mensalidade (dados da CONTRATADA que aparecem no contrato) ---
CONTRATADO_NOME="Rodrigo Ribeiro"
CONTRATADO_DOC=""
CONTRATADO_CIDADE="Florianópolis/SC"
CONTRATADO_EMAIL=""
CONTRATADO_WHATSAPP=""
# Endereço público usado nos links (opcional; o Render já informa sozinho)
PUBLIC_URL=""
